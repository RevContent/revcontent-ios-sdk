"keyword"},{"text":" ","kind":"text"},{"text":"revcontentExploreMore","kind":"identifier"},{"text":"(","kind":"text"},{"text":"config","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ExploreMoreConfig","text":"ExploreMoreConfig","kind":"typeIdentifier","preciseIdentifier":"s:13RevcontentSDK17ExploreMoreConfigV"},{"text":", ","kind":"text"},{"text":"articleId","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"config","content":[{"inlineContent":[{"text":"The widget, title, and frequency capping to use.","type":"text"}],"type":"paragraph"}]},{"name":"articleId","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identity for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/FrequencyCapping\/oncePerArticle"},{"type":"text","text":" — pass the article’s"},{"type":"text","text":" "},{"type":"text","text":"URL. Capping is then per article per browsing session, so a reader who returns to"},{"type":"text","text":" "},{"type":"text","text":"the same article in the same sitting is not prompted twice."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional, and ignored by the other capping modes. Omitting it under"},{"type":"text","text":" "},{"type":"codeVoice","code":".oncePerArticle"},{"type":"text","text":" falls back to capping once per "},{"type":"emphasis","inlineContent":[{"type":"text","text":"view"}]},{"type":"text","text":" lifetime, which is weaker —"},{"type":"text","text":" "},{"type":"text","text":"a fresh push of the same article starts over — but never prompts twice on one"},{"type":"text","text":" "},{"type":"text","text":"screen. Supply it when you can; the SDK cannot recognise an article without it."}]}]}]},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"When applied to an article view inside a ","type":"text"},{"type":"codeVoice","code":"NavigationStack"},{"text":", this modifier","type":"text"},{"text":" ","type":"text"},{"text":"replaces the system back button with a custom one. When the user taps it,","type":"text"},{"text":" ","type":"text"},{"text":"the SDK checks the configured frequency capping; if it should show, a sheet","type":"text"},{"text":" ","type":"text"},{"text":"is presented with the configured widget. Dismissing the sheet completes","type":"text"},{"text":" ","type":"text"},{"text":"the original back navigation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the SDK is not configured ("},{"code":"Revcontent.configure(...)","type":"codeVoice"},{"type":"text","text":" hasn’t been called),"},{"type":"text","text":" "},{"type":"text","text":"this modifier is a no-op and the system back button behaves normally."}]},{"level":2,"anchor":"Example","type":"heading","text":"Example"},{"syntax":"swift","type":"codeListing","code":["NavigationStack {","    ArticleListView()","        .navigationDestination(for: Article.self) { article in","            ArticleDetailView(article: article)","                .revcontentExploreMore(","                    config: ExploreMoreConfig(","                        widgetId: \"explore-more-widget-id\",","                        frequencyCapping: .oncePerArticle","                    ),","                    articleId: article.url.absoluteString","                )","        }","}"]}]}],"sections":[],"references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/ExploreMoreConfig":{"identifier":"doc:\/\/com.revcontent.Rev