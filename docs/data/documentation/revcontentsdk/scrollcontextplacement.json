{"identifier":{"url":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"RevcontentAdView"},{"type":"text","text":" reports widget visibility back to the underlying widget JavaScript so impressions, viewability, and intersection events fire correctly. To do that, the SDK needs a reference to the enclosing "},{"type":"codeVoice","code":"UIScrollView"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View\/revcontentScrollContext()"},{"type":"text","text":" modifier walks the view hierarchy at attach time to find that scroll view. It must be applied to a view that is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"inside"}]},{"type":"text","text":" the "},{"code":"ScrollView","type":"codeVoice"},{"type":"text","text":"’s content — not to the "},{"code":"ScrollView","type":"codeVoice"},{"type":"text","text":" itself, where it would walk the hierarchy "},{"type":"emphasis","inlineContent":[{"type":"text","text":"above"}]},{"type":"text","text":" the scroll view and miss it."}],"type":"paragraph"},{"inlineContent":[{"text":"Misplace the modifier and the SDK’s DEBUG assertions will fire immediately during development. In release, the SDK falls back to a warning and impression data will be missing or inaccurate.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Right way","anchor":"Right-way"},{"inlineContent":[{"text":"Apply the modifier to a view inside the ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":"’s content:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["ScrollView {","    VStack {","        ArticleBody()","        RevcontentAdView(widgetId: \"abc-123\")","    }","    .revcontentScrollContext()","}"],"syntax":"swift"},{"inlineContent":[{"text":"The modifier is on the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":", which is inside the ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":". The finder walks up from the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and discovers the enclosing ","type":"text"},{"code":"UIScrollView","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Wrong way","anchor":"Wrong-way"},{"inlineContent":[{"text":"Do not apply the modifier to the ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" itself:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ WRONG — finder walks above the ScrollView and finds nothing","ScrollView {","    VStack {","        ArticleBody()","        RevcontentAdView(widgetId: \"abc-123\")","    }","}",".revcontentScrollContext()"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Also wrong: forgetting the modifier entirely. The SDK provides a default empty scroll context as a fallback, so "},{"type":"codeVoice","code":"RevcontentAdView"},{"type":"text","text":" will still render — but no scroll-driven events will fire, and DEBUG builds will assert."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Why this design","anchor":"Why-this-design"},{"inlineContent":[{"type":"text","text":"SwiftUI doesn’t expose the underlying "},{"code":"UIScrollView","type":"codeVoice"},{"type":"text","text":" directly. The modifier installs a tiny invisible "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" as a background, then walks up the superview chain at window-attachment time to locate the scroll view. Apply it inside the "},{"code":"ScrollView","type":"codeVoice"},{"type":"text","text":"’s content for that walk to succeed."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/revcontentsdk\/scrollcontextplacement"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/revcontentsdk\/scrollcontextplacement"],"traits":[{"interfaceLanguage":"occ"}]}],"topicSections":[{"anchor":"Related-modifiers","title":"Related modifiers","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View\/revcontentScrollContext()","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView"]}],"metadata":{"modules":[{"name":"RevcontentSDK"}],"title":"Scroll context placement","roleHeading":"API Collection","role":"collectionGroup"},"abstract":[{"text":"Apply ","type":"text"},{"type":"codeVoice","code":"revcontentScrollContext()"},{"text":" inside the ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":"’s content, not on the ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" itself.","type":"text"}],"seeAlsoSections":[{"anchor":"Articles","generated":true,"title":"Articles","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ThemeIntegration","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/JSEventContract":{"title":"JavaScript event contract","type":"topic","url":"\/documentation\/revcontentsdk\/jseventcontract","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract","abstract":[{"text":"Events the SDK dispatches into the embedded widget, for widget JavaScript to consume.","type":"text"}],"role":"article","kind":"article"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/SwiftUICore/View/revcontentScrollContext()":{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View\/revcontentScrollContext()","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"Self","type":"codeVoice"},{"type":"text","text":" is "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}]},"abstract":[{"text":"Marks this view’s enclosing ","type":"text"},{"type":"codeVoice","code":"ScrollView"},{"text":" as the scroll context for any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RevcontentAdView"},{"text":" descendants.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","title":"revcontentScrollContext()","url":"\/documentation\/revcontentsdk\/swiftuicore\/view\/revcontentscrollcontext()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"revcontentScrollContext"},{"kind":"text","text":"() -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/UIKitAndObjectiveC":{"title":"UIKit & Objective-C Integration","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","url":"\/documentation\/revcontentsdk\/uikitandobjectivec","kind":"article","type":"topic","abstract":[{"type":"text","text":"Embed Revcontent ads from UIKit view controllers and Objective-C code with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RVCAdViewController"},{"type":"text","text":", without writing any SwiftUI."}],"role":"collectionGroup"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdView":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":