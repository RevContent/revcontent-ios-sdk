{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"RevcontentSDK communicates with the widget’s JavaScript by dispatching "},{"type":"codeVoice","code":"CustomEvent"},{"type":"text","text":" instances on "},{"type":"codeVoice","code":"document"},{"type":"text","text":". Each event is dispatched with "},{"type":"codeVoice","code":"bubbles: true, cancelable: true"},{"type":"text","text":", and the payload is on "},{"type":"codeVoice","code":"event.detail"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Widgets that want to participate in scroll-driven impression tracking or react to theme changes should add event listeners to "},{"type":"codeVoice","code":"document"},{"type":"text","text":" during their initialization."}],"type":"paragraph"},{"text":"`revcontent:scroll`","level":2,"anchor":"revcontentscroll","type":"heading"},{"inlineContent":[{"text":"Dispatched on every scroll update from the host ","type":"text"},{"code":"ScrollView","type":"codeVoice"},{"text":", throttled to ~30Hz with trailing coalescing. Also fired once immediately after the widget finishes loading, so the widget has initial geometry without waiting for the first scroll.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Payload ("},{"code":"event.detail","type":"codeVoice"},{"type":"text","text":"):"}]}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Type"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"rawOffset"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Number"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The host scroll view’s current ","type":"text"},{"type":"codeVoice","code":"contentOffset.y"},{"text":", in points.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"contentOffset","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Number"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"rawOffset + viewportHeight"},{"type":"text","text":". The y-coordinate, in the scroll view’s content space, of the bottom edge of the visible viewport."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"isWidgetIntersecting"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Boolean"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Whether the widget’s frame currently intersects the visible viewport.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"viewRect","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Object"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The widget’s frame in the host scroll view’s coordinate space: ","type":"text"},{"code":"{ x, y, width, height }","type":"codeVoice"},{"text":", all numbers in points.","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Example listener:","type":"text"}]}],"type":"paragraph"},{"code":["document.addEventListener('revcontent:scroll', (event) => {","    const { isWidgetIntersecting, viewRect, contentOffset } = event.detail;","    if (isWidgetIntersecting) {","        \/\/ Widget is visible — fire viewability logic, mark impressions, etc.","    }","});"],"type":"codeListing","syntax":"javascript"},{"text":"`revcontent:theme`","level":2,"anchor":"revcontenttheme","type":"heading"},{"inlineContent":[{"type":"text","text":"Dispatched whenever the resolved SwiftUI color scheme changes. Fires at first load (after the widget finishes loading, if a scheme was already set) and on every subsequent change."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Payload ("},{"code":"event.detail","type":"codeVoice"},{"type":"text","text":"):"}]}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"colorScheme"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"String"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Either "},{"type":"codeVoice","code":"\"dark\""},{"type":"text","text":" or "},{"type":"codeVoice","code":"\"light\""},{"type":"text","text":"."}]}]]]},{"inlineContent":[{"inlineContent":[{"text":"Example listener:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"code":["document.addEventListener('revcontent:theme', (event) => {","    document.body.dataset.scheme = event.detail.colorScheme;","});"],"type":"codeListing","syntax":"javascript"},{"content":[{"type":"paragraph","inlineContent":[{"text":"In most cases, CSS ","type":"text"},{"type":"codeVoice","code":"@media (prefers-color-scheme: dark)"},{"text":" already reacts correctly thanks to the SDK’s ","type":"text"},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"text":" bridge. Only listen to this event if the widget needs imperative theme handling on top of CSS.","type":"text"}]}],"type":"aside","style":"tip","name":"Tip"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/revcontentsdk\/jseventcontract"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/revcontentsdk\/jseventcontract"],"traits":[{"interfaceLanguage":"o