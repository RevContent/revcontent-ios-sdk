"kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"? = nil) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}]}]},{"kind":"parameters","parameters":[{"name":"config","content":[{"type":"paragraph","inlineContent":[{"text":"The widget, title, and frequency capping to use.","type":"text"}]}]},{"name":"articleId","content":[{"type":"paragraph","inlineContent":[{"text":"Identity for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/FrequencyCapping\/oncePerArticle","type":"reference"},{"text":" — pass the article’s","type":"text"},{"text":" ","type":"text"},{"text":"URL. Capping is then per article per browsing session, so a reader who returns to","type":"text"},{"text":" ","type":"text"},{"text":"the same article in the same sitting is not prompted twice.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional, and ignored by the other capping modes. Omitting it under"},{"type":"text","text":" "},{"type":"codeVoice","code":".oncePerArticle"},{"type":"text","text":" falls back to capping once per "},{"type":"emphasis","inlineContent":[{"text":"view","type":"text"}]},{"type":"text","text":" lifetime, which is weaker —"},{"type":"text","text":" "},{"type":"text","text":"a fresh push of the same article starts over — but never prompts twice on one"},{"type":"text","text":" "},{"type":"text","text":"screen. Supply it when you can; the SDK cannot recognise an article without it."}]}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"When applied to an article view inside a ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":", this modifier","type":"text"},{"text":" ","type":"text"},{"text":"replaces the system back button with a custom one. When the user taps it,","type":"text"},{"text":" ","type":"text"},{"text":"the SDK checks the configured frequency capping; if it should show, a sheet","type":"text"},{"text":" ","type":"text"},{"text":"is presented with the configured widget. Dismissing the sheet completes","type":"text"},{"text":" ","type":"text"},{"text":"the original back navigation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the SDK is not configured ("},{"type":"codeVoice","code":"Revcontent.configure(...)"},{"type":"text","text":" hasn’t been called),"},{"type":"text","text":" "},{"type":"text","text":"this modifier is a no-op and the system back button behaves normally."}],"type":"paragraph"},{"text":"Example","type":"heading","level":2,"anchor":"Example"},{"type":"codeListing","syntax":"swift","code":["NavigationStack {","    ArticleListView()","        .navigationDestination(for: Article.self) { article in","            ArticleDetailView(article: article)","                .revcontentExploreMore(","                    config: ExploreMoreConfig(","                        widgetId: \"explore-more-widget-id\",","                        frequencyCapping: .oncePerArticle","                    ),","                    articleId: article.url.absoluteString","                )","        }","}"]}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Applies explore-more interception to this view.","type":"text"}],"variants":[{"paths":["\/documentation\/revcontentsdk\/swiftuicore\/view\/revcontentexploremore(config:articleid:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View"]]},"references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/SwiftUICore/View"