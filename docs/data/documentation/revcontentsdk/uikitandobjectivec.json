{"identifier":{"url":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"RevcontentSDK"}],"role":"collectionGroup","title":"UIKit & Objective-C Integration"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The SDK’s primary API is SwiftUI (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView"},{"text":"), but many established","type":"text"},{"text":" ","type":"text"},{"text":"publisher apps are UIKit-based, often written partly or entirely in","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C. The Objective-C facade — ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCRevcontent"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController"},{"text":" (","type":"text"},{"code":"RVCAdViewController","type":"codeVoice"},{"text":" in Objective-C), and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling"},{"text":" — exposes the same ad surface to those apps. The","type":"text"},{"text":" ","type":"text"},{"text":"facade hosts the SwiftUI ad view internally, so both integration paths share","type":"text"},{"text":" ","type":"text"},{"text":"one rendering, sizing, and impression-tracking implementation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift UIKit apps can use "},{"code":"RevcontentAdViewController","type":"codeVoice"},{"type":"text","text":" too — it is a more"},{"type":"text","text":" "},{"type":"text","text":"complete UIKit citizen than "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView\/asUIViewController()"},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"returns a bare hosting controller without event callbacks."}],"type":"paragraph"},{"text":"Distribution note for Objective-C apps","level":3,"anchor":"Distribution-note-for-Objective-C-apps","type":"heading"},{"inlineContent":[{"type":"text","text":"Objective-C code can only import the SDK through its "},{"inlineContent":[{"type":"text","text":"binary (XCFramework)"},{"type":"text","text":" "},{"type":"text","text":"distribution"}],"type":"strong"},{"type":"text","text":" — the framework ships the generated "},{"code":"RevcontentSDK-Swift.h","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"that declares the "},{"code":"RVC*","type":"codeVoice"},{"type":"text","text":" symbols. Swift packages built from source have no"},{"type":"text","text":" "},{"type":"text","text":"Objective-C interface header (a SwiftPM limitation), so an app consuming the"},{"type":"text","text":" "},{"type":"text","text":"source package can call the facade only from Swift files. Swift UIKit apps can"},{"type":"text","text":" "},{"type":"text","text":"use either distribution."}],"type":"paragraph"},{"text":"Configure at launch","level":3,"anchor":"Configure-at-launch","type":"heading"},{"inlineContent":[{"text":"Call configure once, on the ","type":"text"},{"inlineContent":[{"type":"text","text":"main thread"}],"type":"strong"},{"text":", before creating any ad","type":"text"},{"text":" ","type":"text"},{"text":"controller. In Objective-C:","type":"text"}],"type":"paragraph"},{"syntax":"objc","code":["\/\/ AppDelegate.m","@import RevcontentSDK;","","- (BOOL)application:(UIApplication *)application","    didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {","    [RVCRevcontent configureWithPublisherId:@\"your-publisher-id\"","                                    siteUrl:@\"https:\/\/your-site.example.com\"","                             loggingEnabled:NO];","    return YES;","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Repeat calls are ignored with a warning, exactly like"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent\/configure(publisherId:siteUrl:loggingEnabled:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Embed the ad controller","level":3,"anchor":"Embed-the-ad-controller","type":"heading"},{"inlineContent":[{"code":"RVCAdViewController","type":"codeVoice"},{"text":" is embedded with standard view-controller containment.","type":"text"},{"text":" ","type":"text"},{"text":"Its view sizes itself to the widget content through Auto Layout — give it a","type":"text"},{"text":" ","type":"text"},{"text":"width (pin leading\/trailing) and let its intrinsic height drive layout:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["RVCAdViewController *ad = [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"];","ad.onLoaded = ^{ NSLog(@\"widget loaded\"); };","ad.onError = ^(NSError *error) { NSLog(@\"widget failed: %@\", error); };","","[self addChildViewController:ad];","ad.view.translatesAutoresizingMaskIntoConstraints = NO;","[self.stackView addArrangedSubview:ad.view];","[ad didMoveToParentViewController:self];","self.adController = ad; \/\/ retain it — the child relationship handles this too"],"syntax":"objc"},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"text":"Keep the controller embedded (or otherwise strongly referenced)","type":"text"},{"text":" ","type":"text"},{"text":"for as long as the ad is on screen. All callback properties may be assigned","type":"text"},{"text":" ","type":"text"},{"text":"or replaced at any time, before or after the view loads.","type":"text"}],"type":"paragraph"}]},{"type":"heading","anchor":"Impression-tracking-is-automatic","text":"Impression tracking is automatic","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"In SwiftUI, publishers apply "},{"type":"codeVoice","code":".revcontentScrollContext()"},{"type":"text","text":" by hand. The UIKit"},{"type":"text","text":" "},{"type":"text","text":"controller does this for you: when its view lands in a window it walks the"},{"type":"text","text":" "},{"type":"text","text":"superview chain and attaches to the nearest "},{"type":"codeVoice","code":"UIScrollView"},{"type":"text","text":" — including a"},{"type":"text","text":" "},{"type":"codeVoice","code":"UITableView"},{"type":"text","text":" or "},{"type":"codeVoice","code":"UICollectionView"},{"type":"text","text":" — and forwards scroll geometry to the"},{"type":"text","text":" "},{"type":"text","text":"widget for viewability measurement."}]},{"type":"paragraph","inlineContent":[{"text":"For the rare placement with no scrolling ancestor (a static, non-scrolling","type":"text"},{"text":" ","type":"text"},{"text":"screen), opt out to silence the missing-scroll-view warning:","type":"text"}]},{"type":"codeListing","code":["RVCAdViewController *ad =","    [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"","                    attachesToEnclosingScrollView:NO];"],"syntax":"objc"},{"type":"heading","anchor":"Sizing-in-table-views","text":"Sizing in table views","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The widget’s height arrives asynchronously as the web content lays out. For"},{"type":"text","text":" "},{"type":"text","text":"self-sizing cells, embed the controller once, hand its view to the ad cell,"},{"type":"text","text":" "},{"type":"text","text":"and let "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onHeightChange"},{"type":"text","text":" drive a row-height"},{"type":"text","text":" "},{"type":"text","text":"update:"}]},{"type":"codeListing","code":["\/\/ viewDidLoad — one controller per placement, reused across cell recycling.","self.adController = [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"];","[self addChildViewController:self.adController];","[self.adController didMoveToParentViewController:self];","","__weak typeof(self) weakSelf = self;","self.adController.onHeightChange = ^(CGFloat height) {","    \/\/ Recompute the ad row's height without reloading (a reload would","    \/\/ re-add the view mid-layout).","    [weakSelf.tableView beginUpdates];","    [weakSelf.tableView endUpdates];","};","","\/\/ cellForRowAtIndexPath — for the ad row:","UIView *adView = self.adController.view;","adView.translatesAutoresizingMaskIntoConstraints = NO;","[cell.contentView addSubview:adView];","\/\/ pin adView to cell.contentView's edges…"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"The current height is also readable at any time via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/contentHeight","isActive":true,"type":"reference"},{"text":" (KVO-observable), for use in","type":"text"},{"text":" ","type":"text"},{"code":"tableView:heightForRowAtIndexPath:","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Link-handling","text":"Link handling","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Links open in "},{"type":"codeVoice","code":"SFSafariViewController"},{"type":"text","text":" by default, presented from the ad"},{"type":"text","text":" "},{"type":"text","text":"controller. Intercept them with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/linkClickHandler"},{"type":"text","text":"; the analytics callback"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onLinkClick"},{"type":"text","text":" fires for every tap regardless:"}]},{"type":"codeListing","code":["ad.linkClickHandler = ^RVCLinkClickHandling(NSURL *url) {","    if ([MyRouter canHandleURL:url]) {","        [MyRouter navigateToURL:url];","        return RVCLinkClickHandlingHandled;   \/\/ SDK skips Safari","    }","    return RVCLinkClickHandlingOpenInSafari;  \/\/ SDK presents Safari","};","ad.onLinkClick = ^(NSURL *url) {","    [MyAnalytics trackAdClick:url];","};"],"syntax":"objc"},{"type":"heading","anchor":"Theming","text":"Theming","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hosted widget follows the trait environment. To force a scheme, set the"},{"type":"text","text":" "},{"type":"text","text":"standard UIKit override on the controller:"}]},{"type":"codeListing","code":["ad.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;"],"syntax":"objc"},{"type":"heading","anchor":"Explore-more","text":"Explore more","level":3},{"type":"paragraph","inlineContent":[{"text":"The explore-more sheet works the same way it does in SwiftUI: attach it to an","type":"text"},{"text":" ","type":"text"},{"text":"article view controller pushed onto a ","type":"text"},{"code":"UINavigationController","type":"codeVoice"},{"text":", and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"replaces the back button with its own. On tap, the configured frequency","type":"text"},{"text":" ","type":"text"},{"text":"capping decides whether to present the sheet; dismissing the sheet — close","type":"text"},{"text":" ","type":"text"},{"text":"button, swipe down, or the error state’s Continue — completes the original","type":"text"},{"text":" ","type":"text"},{"text":"back navigation. The decision logic, frequency state, and sheet UI are shared","type":"text"},{"text":" ","type":"text"},{"text":"with the SwiftUI implementation, so the two behave identically.","type":"text"}]},{"type":"codeListing","code":["\/\/ ArticleViewController.m","- (void)viewDidLoad {","    [super viewDidLoad];","    RVCExploreMoreConfig *config =","        [[RVCExploreMoreConfig alloc] initWithWidgetId:@\"explore-widget-id\"","                                                 title:@\"Before you go\"","                                       frequencyCapping:RVCFrequencyCappingOncePerSession];","    [RVCExploreMore attachToViewController:self config:config];","}"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because Objective-C enums cannot carry associated values, the native"},{"type":"text","text":" "},{"code":".custom(TimeInterval)","type":"codeVoice"},{"type":"text","text":" capping is expressed as"},{"type":"text","text":" "},{"code":"RVCFrequencyCappingCustom","type":"codeVoice"},{"type":"text","text":" plus an interval:"}]},{"type":"codeListing","code":["\/\/ At most once every 12 hours:","RVCExploreMoreConfig *config =","    [[RVCExploreMoreConfig alloc] initWithWidgetId:@\"explore-widget-id\"","                                             title:@\"Before you go\"","                                   frequencyCapping:RVCFrequencyCappingCustom","                                     customInterval:12 * 60 * 60];"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"text":"Like the SwiftUI modifier, attaching is a no-op (with a logged warning) if","type":"text"},{"text":" ","type":"text"},{"text":"the SDK has not been configured, and replacing the back button disables the","type":"text"},{"text":" ","type":"text"},{"text":"interactive swipe-back gesture. For a modally presented controller, the","type":"text"},{"text":" ","type":"text"},{"text":"completed “back” is a modal dismissal instead of a pop.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the attached controller’s "},{"type":"emphasis","inlineContent":[{"type":"text","text":"content"}]},{"type":"text","text":" is irrelevant — the trigger is"},{"type":"text","text":" "},{"type":"text","text":"the navigation-bar back affordance, so an article rendered in a full-screen"},{"type":"text","text":" "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" works exactly like a native one."}]},{"type":"heading","anchor":"When-the-app-owns-the-back-action","text":"When the app owns the back action","level":4},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attachToViewController:"},{"type":"text","text":" needs a back button to replace and a pop to complete."},{"type":"text","text":" "},{"type":"text","text":"Neither exists when the app is essentially a browser: one long-lived "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":" "},{"type":"text","text":"navigating in place, where “back” is the app’s own control calling "},{"type":"codeVoice","code":"goBack"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore\/presentIfNeeded(from:config:articleId:completion:)","isActive":true},{"type":"text","text":" covers"},{"type":"text","text":" "},{"type":"text","text":"that. The SDK evaluates the frequency capping and presents the sheet; the"},{"type":"text","text":" "},{"type":"text","text":"completion block runs the app’s own back action."}]},{"type":"codeListing","code":["- (void)backButtonTapped {","    RVCExploreMoreConfig *config =","        [[RVCExploreMoreConfig alloc] initWithWidgetId:@\"explore-widget-id\"","                                                 title:@\"Before you go\"","                                       frequencyCapping:RVCFrequencyCappingOncePerArticle];","","    __weak typeof(self) weakSelf = self;","    [RVCExploreMore presentIfNeededFrom:self","                                 config:config","                              articleId:self.webView.URL.absoluteString","                             completion:^{ [weakSelf.webView goBack]; }];","}"],"syntax":"objc"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three things to know:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"completion"},{"type":"text","text":" runs "},{"type":"strong","inlineContent":[{"text":"exactly once, on the main thread","type":"text"}]},{"type":"text","text":" — after the sheet is"},{"type":"text","text":" "},{"type":"text","text":"dismissed if it was presented, immediately if it wasn’t (capping declined, the"},{"type":"text","text":" "},{"type":"text","text":"SDK is unconfigured, or the controller is already presenting). Put the back"},{"type":"text","text":" "},{"type":"text","text":"action there and nowhere else. The "},{"type":"codeVoice","code":"BOOL"},{"type":"text","text":" return says whether the sheet was"},{"type":"text","text":" "},{"type":"text","text":"presented, so a caller can avoid animating its own transition underneath it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Pass ","type":"text"},{"code":"articleId","type":"codeVoice"},{"text":" when using ","type":"text"},{"code":"RVCFrequencyCappingOncePerArticle","type":"codeVoice"},{"text":". One controller","type":"text"},{"text":" ","type":"text"},{"text":"serves every article here, so the per-controller flag the attach path relies on","type":"text"},{"text":" ","type":"text"},{"text":"would never reset; the URL is the natural identity. Other capping modes ignore","type":"text"},{"text":" ","type":"text"},{"text":"it, and passing ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" under ","type":"text"},{"code":"oncePerArticle","type":"codeVoice"},{"text":" logs a warning and does not cap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The navigation item is left untouched, so unlike "},{"code":"attachToViewController:","type":"codeVoice"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"system back button and swipe-back gesture keep working."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Let the SDK dismiss its own sheet — dismissing it out from under the SDK bypasses"},{"type":"text","text":" "},{"type":"text","text":"the paths that run "},{"type":"codeVoice","code":"completion"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both shapes ship as runnable screens in the "},{"code":"SampleAppObjC","type":"codeVoice"},{"type":"text","text":" scheme"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"WebArticleViewController","type":"codeVoice"},{"type":"text","text":" and "},{"code":"WebBrowserViewController","type":"codeVoice"},{"type":"text","text":")."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/revcontentsdk\/uikitandobjectivec"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/revcontentsdk\/uikitandobjectivec"]}],"topicSections":[{"anchor":"Facade-API","title":"Facade API","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCRevcontent","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMoreConfig","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCFrequencyCapping"]}],"hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK"]]},"sections":[],"abstract":[{"type":"text","text":"Embed Revcontent ads from UIKit view controllers and Objective-C code with"},{"type":"text","text":" "},{"code":"RVCAdViewController","type":"codeVoice"},{"type":"text","text":", without writing any SwiftUI."}],"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ThemeIntegration","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"],"generated":true,"anchor":"Articles"}],"references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/ScrollContextPlacement":{"url":"\/documentation\/revcontentsdk\/scrollcontextplacement","kind":"article","type":"topic","abstract":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":"revcontentScrollContext()"},{"type":"text","text":" inside the "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":"’s content, not on the "},{"type":"codeVoice","code":"ScrollView"},{"type":"text","text":" itself."}],"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","role":"collectionGroup","title":"Scroll context placement"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCExploreMoreConfig":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RVCExploreMoreConfig"}],"title":"RVCExploreMoreConfig","url":"\/documentation\/revcontentsdk\/rvcexploremoreconfig","abstract":[{"type":"text","text":"Objective-C configuration for the explore-more sheet, used with"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore\/attach(to:config:)","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RVCExploreMoreConfig"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMoreConfig"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK":{"role":"collection","url":"\/documentation\/revcontentsdk","kind":"symbol","title":"RevcontentSDK","type":"topic","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK","abstract":[{"text":"Native SwiftUI integration for Revcontent ad widgets.","type":"text"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/Revcontent":{"kind":"symbol","type":"topic","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent","abstract":[],"title":"Revcontent","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Revcontent"}],"navigatorTitle":[{"kind":"identifier","text":"Revcontent"}],"url":"\/documentation\/revcontentsdk\/revcontent"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/LinkClickHandling":{"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LinkClickHandling","kind":"identifier"}],"type":"topic","title":"LinkClickHandling","abstract":[{"text":"Return value for ","type":"text"},{"type":"codeVoice","code":"RevcontentAdView.handleLinkClick(_:)"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Controls whether the SDK presents its default ","type":"text"},{"type":"codeVoice","code":"SFSafariViewController"},{"text":" ","type":"text"},{"text":"for the clicked link, or yields entirely to the publisher’s handler.","type":"text"}],"kind":"symbol","navigatorTitle":[{"text":"LinkClickHandling","kind":"identifier"}],"url":"\/documentation\/revcontentsdk\/linkclickhandling","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/LinkClickHandling"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/Revcontent/configure(publisherId:siteUrl:loggingEnabled:)":{"kind":"symbol","url":"\/documentation\/revcontentsdk\/revcontent\/configure(publisherid:siteurl:loggingenabled:)","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent\/configure(publisherId:siteUrl:loggingEnabled:)","title":"configure(publisherId:siteUrl:loggingEnabled:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"configure"},{"kind":"text","text":"("},{"kind":"externalParam","text":"publisherId"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"siteUrl"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"loggingEnabled"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Configures the SDK. Call once at app launch, before instantiating any"},{"type":"text","text":" "},{"type":"codeVoice","code":"RevcontentAdView"},{"type":"text","text":". Subsequent calls are ignored with a warning."}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCLinkClickHandling":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling","navigatorTitle":[{"text":"RVCLinkClickHandling","kind":"identifier"}],"url":"\/documentation\/revcontentsdk\/rvclinkclickhandling","abstract":[{"text":"Objective-C representation of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/LinkClickHandling"},{"text":", returned from","type":"text"},{"text":" ","type":"text"},{"isActiv