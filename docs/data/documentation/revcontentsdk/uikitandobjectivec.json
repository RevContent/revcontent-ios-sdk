{"abstract":[{"type":"text","text":"Embed Revcontent ads from UIKit view controllers and Objective-C code with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RVCAdViewController"},{"type":"text","text":", without writing any SwiftUI."}],"sections":[],"identifier":{"url":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ThemeIntegration","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"],"anchor":"Articles","generated":true}],"metadata":{"modules":[{"name":"RevcontentSDK"}],"roleHeading":"API Collection","title":"UIKit & Objective-C Integration","role":"collectionGroup"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/revcontentsdk\/uikitandobjectivec"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/revcontentsdk\/uikitandobjectivec"]}],"hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"title":"Facade API","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCRevcontent","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMoreConfig","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCFrequencyCapping"],"anchor":"Facade-API"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"The SDK’s primary API is SwiftUI (","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView","type":"reference"},{"text":"), but many established","type":"text"},{"text":" ","type":"text"},{"text":"publisher apps are UIKit-based, often written partly or entirely in","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C. The Objective-C facade — ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCRevcontent","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController","type":"reference"},{"type":"text","text":" ("},{"type":"codeVoice","code":"RVCAdViewController"},{"type":"text","text":" in Objective-C), and"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling","type":"reference","isActive":true},{"type":"text","text":" — exposes the same ad surface to those apps. The"},{"type":"text","text":" "},{"type":"text","text":"facade hosts the SwiftUI ad view internally, so both integration paths share"},{"type":"text","text":" "},{"type":"text","text":"one rendering, sizing, and impression-tracking implementation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swift UIKit apps can use "},{"type":"codeVoice","code":"RevcontentAdViewController"},{"type":"text","text":" too — it is a more"},{"type":"text","text":" "},{"type":"text","text":"complete UIKit citizen than "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView\/asUIViewController()","isActive":true},{"type":"text","text":", which"},{"type":"text","text":" "},{"type":"text","text":"returns a bare hosting controller without event callbacks."}],"type":"paragraph"},{"level":3,"text":"Distribution note for Objective-C apps","type":"heading","anchor":"Distribution-note-for-Objective-C-apps"},{"inlineContent":[{"text":"Objective-C code can only import the SDK through its ","type":"text"},{"inlineContent":[{"text":"binary (XCFramework)","type":"text"},{"text":" ","type":"text"},{"text":"distribution","type":"text"}],"type":"strong"},{"text":" — the framework ships the generated ","type":"text"},{"code":"RevcontentSDK-Swift.h","type":"codeVoice"},{"text":" ","type":"text"},{"text":"that declares the ","type":"text"},{"code":"RVC*","type":"codeVoice"},{"text":" symbols. Swift packages built from source have no","type":"text"},{"text":" ","type":"text"},{"text":"Objective-C interface header (a SwiftPM limitation), so an app consuming the","type":"text"},{"text":" ","type":"text"},{"text":"source package can call the facade only from Swift files. Swift UIKit apps can","type":"text"},{"text":" ","type":"text"},{"text":"use either distribution.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Configure at launch","type":"heading","anchor":"Configure-at-launch"},{"inlineContent":[{"text":"Call configure once, on the ","type":"text"},{"inlineContent":[{"text":"main thread","type":"text"}],"type":"strong"},{"text":", before creating any ad","type":"text"},{"text":" ","type":"text"},{"text":"controller. In Objective-C:","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppDelegate.m","@import RevcontentSDK;","","- (BOOL)application:(UIApplication *)application","    didFinishLaunchingWithOptions:(NSDictionary *)launchOptions {","    [RVCRevcontent configureWithPublisherId:@\"your-publisher-id\"","                                    siteUrl:@\"https:\/\/your-site.example.com\"","                             loggingEnabled:NO];","    return YES;","}"],"type":"codeListing","syntax":"objc"},{"inlineContent":[{"type":"text","text":"Repeat calls are ignored with a warning, exactly like"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent\/configure(publisherId:siteUrl:loggingEnabled:)"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Embed the ad controller","type":"heading","anchor":"Embed-the-ad-controller"},{"inlineContent":[{"code":"RVCAdViewController","type":"codeVoice"},{"text":" is embedded with standard view-controller containment.","type":"text"},{"text":" ","type":"text"},{"text":"Its view sizes itself to the widget content through Auto Layout — give it a","type":"text"},{"text":" ","type":"text"},{"text":"width (pin leading\/trailing) and let its intrinsic height drive layout:","type":"text"}],"type":"paragraph"},{"code":["RVCAdViewController *ad = [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"];","ad.onLoaded = ^{ NSLog(@\"widget loaded\"); };","ad.onError = ^(NSError *error) { NSLog(@\"widget failed: %@\", error); };","","[self addChildViewController:ad];","ad.view.translatesAutoresizingMaskIntoConstraints = NO;","[self.stackView addArrangedSubview:ad.view];","[ad didMoveToParentViewController:self];","self.adController = ad; \/\/ retain it — the child relationship handles this too"],"type":"codeListing","syntax":"objc"},{"type":"aside","content":[{"inlineContent":[{"text":"Keep the controller embedded (or otherwise strongly referenced)","type":"text"},{"text":" ","type":"text"},{"text":"for as long as the ad is on screen. All callback properties may be assigned","type":"text"},{"text":" ","type":"text"},{"text":"or replaced at any time, before or after the view loads.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important"},{"level":3,"text":"Impression tracking is automatic","type":"heading","anchor":"Impression-tracking-is-automatic"},{"inlineContent":[{"text":"In SwiftUI, publishers apply ","type":"text"},{"type":"codeVoice","code":".revcontentScrollContext()"},{"text":" by hand. The UIKit","type":"text"},{"text":" ","type":"text"},{"text":"controller does this for you: when its view lands in a window it walks the","type":"text"},{"text":" ","type":"text"},{"text":"superview chain and attaches to the nearest ","type":"text"},{"type":"codeVoice","code":"UIScrollView"},{"text":" — including a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UITableView"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"UICollectionView"},{"text":" — and forwards scroll geometry to the","type":"text"},{"text":" ","type":"text"},{"text":"widget for viewability measurement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For the rare placement with no scrolling ancestor (a static, non-scrolling","type":"text"},{"text":" ","type":"text"},{"text":"screen), opt out to silence the missing-scroll-view warning:","type":"text"}],"type":"paragraph"},{"code":["RVCAdViewController *ad =","    [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"","                    attachesToEnclosingScrollView:NO];"],"type":"codeListing","syntax":"objc"},{"level":3,"text":"Sizing in table views","type":"heading","anchor":"Sizing-in-table-views"},{"inlineContent":[{"text":"The widget’s height arrives asynchronously as the web content lays out. For","type":"text"},{"text":" ","type":"text"},{"text":"self-sizing cells, embed the controller once, hand its view to the ad cell,","type":"text"},{"text":" ","type":"text"},{"text":"and let ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onHeightChange","type":"reference"},{"text":" drive a row-height","type":"text"},{"text":" ","type":"text"},{"text":"update:","type":"text"}],"type":"paragraph"},{"code":["\/\/ viewDidLoad — one controller per placement, reused across cell recycling.","self.adController = [[RVCAdViewController alloc] initWithWidgetId:@\"your-widget-id\"];","[self addChildViewController:self.adController];","[self.adController didMoveToParentViewController:self];","","__weak typeof(self) weakSelf = self;","self.adController.onHeightChange = ^(CGFloat height) {","    \/\/ Recompute the ad row's height without reloading (a reload would","    \/\/ re-add the view mid-layout).","    [weakSelf.tableView beginUpdates];","    [weakSelf.tableView endUpdates];","};","","\/\/ cellForRowAtIndexPath — for the ad row:","UIView *adView = self.adController.view;","adView.translatesAutoresizingMaskIntoConstraints = NO;","[cell.contentView addSubview:adView];","\/\/ pin adView to cell.contentView's edges…"],"type":"codeListing","syntax":"objc"},{"inlineContent":[{"type":"text","text":"The current height is also readable at any time via"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/contentHeight"},{"type":"text","text":" (KVO-observable), for use in"},{"type":"text","text":" "},{"type":"codeVoice","code":"tableView:heightForRowAtIndexPath:"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Link handling","type":"heading","anchor":"Link-handling"},{"inlineContent":[{"type":"text","text":"Links open in "},{"type":"codeVoice","code":"SFSafariViewController"},{"type":"text","text":" by default, presented from the ad"},{"type":"text","text":" "},{"type":"text","text":"controller. Intercept them with"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/linkClickHandler","type":"reference","isActive":true},{"type":"text","text":"; the analytics callback"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onLinkClick","type":"reference","isActive":true},{"type":"text","text":" fires for every tap regardless:"}],"type":"paragraph"},{"code":["ad.linkClickHandler = ^RVCLinkClickHandling(NSURL *url) {","    if ([MyRouter canHandleURL:url]) {","        [MyRouter navigateToURL:url];","        return RVCLinkClickHandlingHandled;   \/\/ SDK skips Safari","    }","    return RVCLinkClickHandlingOpenInSafari;  \/\/ SDK presents Safari","};","ad.onLinkClick = ^(NSURL *url) {","    [MyAnalytics trackAdClick:url];","};"],"type":"codeListing","syntax":"objc"},{"level":3,"text":"Theming","type":"heading","anchor":"Theming"},{"inlineContent":[{"text":"The hosted widget follows the trait environment. To force a scheme, set the","type":"text"},{"text":" ","type":"text"},{"text":"standard UIKit override on the controller:","type":"text"}],"type":"paragraph"},{"code":["ad.overrideUserInterfaceStyle = UIUserInterfaceStyleDark;"],"type":"codeListing","syntax":"objc"},{"level":3,"text":"Explore more","type":"heading","anchor":"Explore-more"},{"inlineContent":[{"text":"The explore-more sheet works the same way it does in SwiftUI: attach it to an","type":"text"},{"text":" ","type":"text"},{"text":"article view controller pushed onto a ","type":"text"},{"code":"UINavigationController","type":"codeVoice"},{"text":", and the SDK","type":"text"},{"text":" ","type":"text"},{"text":"replaces the back button with its own. On tap, the configured frequency","type":"text"},{"text":" ","type":"text"},{"text":"capping decides whether to present the sheet; dismissing the sheet — close","type":"text"},{"text":" ","type":"text"},{"text":"button, swipe down, or the error state’s Continue — completes the original","type":"text"},{"text":" ","type":"text"},{"text":"back navigation. The decision logic, frequency state, and sheet UI are shared","type":"text"},{"text":" ","type":"text"},{"text":"with the SwiftUI implementation, so the two behave identically.","type":"text"}],"type":"paragraph"},{"code":["\/\/ ArticleViewController.m","- (void)viewDidLoad {","    [super viewDidLoad];","    RVCExploreMoreConfig *config =","        [[RVCExploreMoreConfig alloc] initWithWidgetId:@\"explore-widget-id\"","                                                 title:@\"Before you go\"","                                       frequencyCapping:RVCFrequencyCappingOncePerSession];","    [RVCExploreMore attachToViewController:self config:config];","}"],"type":"codeListing","syntax":"objc"},{"inlineContent":[{"type":"text","text":"Because Objective-C enums cannot carry associated values, the native"},{"type":"text","text":" "},{"type":"codeVoice","code":".custom(TimeInterval)"},{"type":"text","text":" capping is expressed as"},{"type":"text","text":" "},{"type":"codeVoice","code":"RVCFrequencyCappingCustom"},{"type":"text","text":" plus an interval:"}],"type":"paragraph"},{"code":["\/\/ At most once every 12 hours:","RVCExploreMoreConfig *config =","    [[RVCExploreMoreConfig alloc] initWithWidgetId:@\"explore-widget-id\"","                                             title:@\"Before you go\"","                                   frequencyCapping:RVCFrequencyCappingCustom","                                     customInterval:12 * 60 * 60];"],"type":"codeListing","syntax":"objc"},{"inlineContent":[{"text":"Like the SwiftUI modifier, attaching is a no-op (with a logged warning) if","type":"text"},{"text":" ","type":"text"},{"text":"the SDK has not been configured, and replacing the back button disables the","type":"text"},{"text":" ","type":"text"},{"text":"interactive swipe-back gesture. For a modally presented controller, the","type":"text"},{"text":" ","type":"text"},{"text":"completed “back” is a modal dismissal instead of a pop.","type":"text"}],"type":"paragraph"}]}],"kind":"article","references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCRevcontent":{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCRevcontent","url":"\/documentation\/revcontentsdk\/rvcrevcontent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RVCRevcontent"}],"abstract":[{"type":"text","text":"Objective-C entry point for SDK configuration. Forwards to "},{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent","type":"reference","isActive":true},{"type":"text","text":"."}],"role":"symbol","title":"RVCRevcontent","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RVCRevcontent"}],"kind":"symbol"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdViewController":{"abstract":[{"text":"A ","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":" that displays a Revcontent ad widget, for UIKit-based","type":"text"},{"text":" ","type":"text"},{"text":"and Objective-C apps. Exposed to Objective-C as ","type":"text"},{"code":"RVCAdViewController","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RevcontentAdViewController"}],"role":"symbol","url":"\/documentation\/revcontentsdk\/revcontentadviewcontroller","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController","type":"topic","title":"RevcontentAdViewController","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RevcontentAdViewController"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/Revcontent":{"abstract":[],"type":"topic","role":"symbol","url":"\/documentation\/revcontentsdk\/revcontent","kind":"symbol","title":"Revcontent","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/Revcontent","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Revcontent"}],"navigatorTitle":[{"kind":"identifier","text":"Revcontent"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCExploreMore":{"type":"topic","kind":"symbol","url":"\/documentation\/revcontentsdk\/rvcexploremore","title":"RVCExploreMore","role":"symbol","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RVCExploreMore","kind":"identifier"}],"navigatorTitle":[{"text":"RVCExploreMore","kind":"identifier"}],"abstract":[{"text":"UIKit \/ Objective-C entry point for the explore-more feature.","type":"text"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCLinkClickHandling":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RVCLinkClickHandling"}],"abstract":[{"type":"text","text":"Objective-C representation of "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/LinkClickHandling","isActive":true},{"type":"text","text":", returned from"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/linkClickHandler","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCLinkClickHandling","title":"RVCLinkClickHandling","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RVCLinkClickHandling"}],"kind":"symbol","type":"topic","url":"\/documentation\/revcontentsdk\/rvclinkclickhandling"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdView/asUIViewController()":{"url":"\/documentation\/revcontentsdk\/revcontentadview\/asuiviewcontroller()","title":"asUIViewController()","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdView\/asUIViewController()","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"asUIViewController"},{"kind":"text","text":"() -> "},{"preciseIdentifier":"c:objc(cs)UIViewController","kind":"typeIdentifier","text":"UIViewController"}],"abstract":[{"text":"Wraps this view in a ","type":"text"},{"type":"codeVoice","code":"UIHostingController"},{"text":" for use in UIKit-based apps.","type":"text"}],"type":"topic"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/FrequencyCapping":{"url":"\/documentation\/revcontentsdk\/frequencycapping","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/FrequencyCapping","kind":"symbol","navigatorTitle":[{"text":"FrequencyCapping","kind":"identifier"}],"role":"symbol","title":"FrequencyCapping","type":"topic","abstract":[{"type":"text","text":"Controls how frequently the explore-more sheet is shown to a user."}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrequencyCapping","kind":"identifier"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/JSEventContract":{"title":"JavaScript event contract","url":"\/documentation\/revcontentsdk\/jseventcontract","abstract":[{"text":"Events the SDK dispatches into the embedded widget, for widget JavaScript to consume.","type":"text"}],"type":"topic","role":"article","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract","kind":"article"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdViewController/onLinkClick":{"abstract":[{"type":"text","text":"Called when a user taps a link inside the widget. Fires for every link"},{"type":"text","text":" "},{"type":"text","text":"click regardless of what "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/linkClickHandler","isActive":true},{"type":"text","text":" returns. Useful for analytics."}],"role":"symbol","kind":"symbol","title":"onLinkClick","navigatorTitle":[{"kind":"identifier","text":"onLinkClick"}],"url":"\/documentation\/revcontentsdk\/revcontentadviewcontroller\/onlinkclick","type":"topic","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onLinkClick","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"onLinkClick"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")?"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdViewController/linkClickHandler":{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/linkClickHandler","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"linkClickHandler"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"c:@M@RevcontentSDK@E@RVCLinkClickHandling","text":"RVCLinkClickHandling"},{"kind":"text","text":")?"}],"navigatorTitle":[{"kind":"identifier","text":"linkClickHandler"}],"abstract":[{"text":"Intercepts link clicks before the SDK opens them in ","type":"text"},{"code":"SFSafariViewController","type":"codeVoice"},{"text":".","type":"text"}],"url":"\/documentation\/revcontentsdk\/revcontentadviewcontroller\/linkclickhandler","kind":"symbol","role":"symbol","title":"linkClickHandler"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdViewController/onHeightChange":{"identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RevcontentAdViewController\/onHeightChange","url":"\/documentation\/revcontentsdk\/revcontentadviewcontroller\/onheightchange","abstract":[{"text":"Called when the widget reports a new content height, in points.","type":"text"},{"text":" ","type":"text"},{"text":"Use it to drive manual layout such as ","type":"text"},{"code":"UITableView","type":"codeVoice"},{"text":" cell heights.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"onHeightChange"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"onHeightChange"},{"kind":"text","text":": (("},{"kind":"typeIdentifier","text":"CGFloat","preciseIdentifier":"s:14CoreFoundation7CGFloatV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":")?"}],"title":"onHeightChange"},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RVCExploreMoreConfig":{"title":"RVCExploreMoreConfig","role":"symbol","abstract":[{"type":"text","text":"Objective-C configuration for the explore-more sheet, used with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMore\/attach(to:config:)","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/revcontentsdk\/rvcexploremoreconfig","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/RVCExploreMoreConfig","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RVCExploreMoreConfig","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"RVCExploreMoreConfig","kind":"identifier"}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/ThemeIntegration":{"url":"\/documentation\/revcontentsdk\/themeintegration","kind":"article","title":"Theme integration","type":"topic","role":"collectionGroup","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ThemeIntegration","abstract":[{"type":"text","text":"Coordinate the widget’s appearance with your app’s color scheme."}]},"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK/RevcontentAdViewController/contentHeight":{"fragments":[{"text":"var","k