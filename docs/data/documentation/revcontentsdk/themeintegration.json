{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"RevcontentSDK bridges SwiftUI’s color scheme into the embedded widget via two channels:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The underlying "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":", so any CSS using "},{"type":"codeVoice","code":"@media (prefers-color-scheme: dark)"},{"type":"text","text":" resolves correctly."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"revcontent:theme"},{"type":"text","text":" JavaScript event dispatched to the widget on change, so widget code can react explicitly."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Both fire whenever the resolved SwiftUI color scheme changes — at first load and on every subsequent toggle.","type":"text"}],"type":"paragraph"},{"text":"Letting the widget inherit the system scheme","anchor":"Letting-the-widget-inherit-the-system-scheme","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"By default, "},{"type":"codeVoice","code":"RevcontentAdView"},{"type":"text","text":" inherits the color scheme from the SwiftUI environment, which is driven by the user’s system setting. No extra code required:"}],"type":"paragraph"},{"code":["RevcontentAdView(widgetId: \"abc-123\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the user toggles dark mode in Settings, the widget receives a "},{"code":"revcontent:theme","type":"codeVoice"},{"type":"text","text":" event and its "},{"code":"overrideUserInterfaceStyle","type":"codeVoice"},{"type":"text","text":" updates accordingly."}],"type":"paragraph"},{"text":"Forcing a specific scheme","anchor":"Forcing-a-specific-scheme","type":"heading","level":2},{"inlineContent":[{"text":"Override the color scheme with the dedicated modifier:","type":"text"}],"type":"paragraph"},{"code":["RevcontentAdView(widgetId: \"abc-123\")","    .revcontentColorScheme(.dark)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is equivalent to "},{"code":".environment(\\.colorScheme, .dark)","type":"codeVoice"},{"type":"text","text":" but reads more clearly. Use it when you want the widget pinned to a specific appearance regardless of system setting — for example, inside an in-app reader that’s always dark."}],"type":"paragraph"},{"inlineContent":[{"text":"You can also use SwiftUI’s built-in ","type":"text"},{"code":".preferredColorScheme(_:)","type":"codeVoice"},{"text":" higher up the view tree to set the scheme app-wide; the widget will follow.","type":"text"}],"type":"paragraph"},{"text":"What the widget should do","anchor":"What-the-widget-should-do","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The widget’s CSS and JavaScript should respect both bridge channels:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CSS"}],"type":"strong"},{"type":"text","text":": use "},{"type":"codeVoice","code":"@media (prefers-color-scheme: dark) { ... }"},{"type":"text","text":" for dark-mode styles. The SDK’s "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":" ensures this resolves correctly inside the "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JavaScript"}]},{"type":"text","text":": optionally listen for "},{"type":"codeVoice","code":"revcontent:theme"},{"type":"text","text":" events on "},{"type":"codeVoice","code":"document"},{"type":"text","text":" if the widget needs to react imperatively. See "},{"type":"reference","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract","isActive":true},{"type":"text","text":" for the payload shape."}]}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"Coordinate the widget’s appearance with your app’s color scheme."}],"hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK"]]},"metadata":{"title":"Theme integration","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"RevcontentSDK"}]},"topicSections":[{"title":"Related","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View\/revcontentColorScheme(_:)","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"],"anchor":"Related"}],"kind":"article","variants":[{"paths":["\/documentation\/revcontentsdk\/themeintegration"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/revcontentsdk\/themeintegration"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"url":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ThemeIntegration","interfaceLanguage":"swift"},"sections":[],"seeAlsoSections":[{"title":"Articles","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"],"generated":true,"anchor":"Articles"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.revcontent.RevcontentSDK/documentation/RevcontentSDK":{"role":"collection","url":"\/documentation\/revcontentsdk","kind":"symbol","title":"RevcontentSDK","type":"topic","identifier":"doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK","abstract":[{"text":"Native SwiftUI integration for Revcontent ad widgets.","type":"text"}]},"doc://com.revcontent.Revcontent