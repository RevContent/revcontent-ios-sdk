{"kind":"article","abstract":[{"type":"text","text":"Coordinate the widget’s appearance with your app’s color scheme."}],"topicSections":[{"anchor":"Related","title":"Related","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/SwiftUICore\/View\/revcontentColorScheme(_:)","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"]}],"hierarchy":{"paths":[["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK"]]},"metadata":{"role":"collectionGroup","title":"Theme integration","roleHeading":"API Collection","modules":[{"name":"RevcontentSDK"}]},"seeAlsoSections":[{"generated":true,"anchor":"Articles","title":"Articles","identifiers":["doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/ScrollContextPlacement","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/UIKitAndObjectiveC","doc:\/\/com.revcontent.RevcontentSDK\/documentation\/RevcontentSDK\/JSEventContract"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"RevcontentSDK bridges SwiftUI’s color scheme into the embedded widget via two channels:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The underlying "},{"type":"codeVoice","code":"WKWebView"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"overrideUserInterfaceStyle"},{"type":"text","text":", so any CSS using "},{"type":"codeVoice","code":"@media (prefers-color-scheme: dark)"},{"type":"text","text":" resolves correctly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"revcontent:theme","type":"codeVoice"},{"text":" JavaScript event dispatched to the widget on change, so widget code can react explicitly.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Both fire whenever the resolved